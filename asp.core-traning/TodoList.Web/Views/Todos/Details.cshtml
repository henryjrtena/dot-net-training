@model TodoList.Web.Models.TodoItemViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Todo #@Model.Id</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Assigned To</dt>
            <dd class="col-sm-9">@Model.AssignedTo</dd>

            <dt class="col-sm-3">Due Date</dt>
            <dd class="col-sm-9">@Model.DueDate</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@(Model.IsDone ? "Done" : "Active")</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Todos" asp-action="Index" class="btn btn-outline-secondary">Back to Todos</a>
</div>
