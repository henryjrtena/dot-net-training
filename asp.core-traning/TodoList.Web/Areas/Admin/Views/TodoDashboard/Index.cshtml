@model TodoList.Web.Models.TodoDashboardViewModel

@{
    ViewData["Title"] = "Todo Admin Dashboard";
}

<h1>Todo Admin Dashboard</h1>
<p class="text-muted">Review overdue todos, completed counts, and team workload from the Admin area.</p>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h6 text-muted">Total</h2>
                <p class="display-6 mb-0">@Model.TotalTodos</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h6 text-muted">Completed</h2>
                <p class="display-6 mb-0">@Model.CompletedTodos</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h6 text-muted">Overdue</h2>
                <p class="display-6 mb-0">@Model.OverdueTodos</p>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h5">Team Workload</h2>
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Todos</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var entry in Model.TeamWorkload)
            {
                <tr>
                    <td>@entry.Key</td>
                    <td>@entry.Value</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
